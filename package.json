{
  "name": "@noirstack/web-foundation",
  "version": "0.3.0",
  "description": "Shared web foundation platform — SEO, security, analytics, observability, middleware for all no1rstack apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "import": "./dist/seo/index.js"
    },
    "./quality": {
      "types": "./dist/quality/index.d.ts",
      "import": "./dist/quality/index.js"
    },
    "./package.json": "./package.json",
    "./rendering": {
      "types": "./dist/rendering/index.d.ts",
      "import": "./dist/rendering/index.js"
    },
    "./performance": {
      "types": "./dist/performance/index.d.ts",
      "import": "./dist/performance/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run check",
    "check": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "seo",
    "security",
    "middleware",
    "web-foundation",
    "sitemap",
    "structured-data",
    "open-graph",
    "robots",
    "canonical",
    "web-vitals",
    "core-web-vitals",
    "performance",
    "rum",
    "schema.org",
    "json-ld",
    "ai-media",
    "lighthouse",
    "accessibility",
    "seo-audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no1rstack/web-foundation.git"
  },
  "homepage": "https://github.com/no1rstack/web-foundation#readme",
  "bugs": {
    "url": "https://github.com/no1rstack/web-foundation/issues"
  },
  "peerDependencies": {
    "express": "^4.17.0 || ^5.0.0",
    "@lhci/cli": "^0.15.1",
    "axe-core": "^4.12.1",
    "html-validate": "^11.5.6",
    "linkinator": "^7.6.1",
    "puppeteer": "^25.3.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@lhci/cli": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "html-validate": {
      "optional": true
    },
    "linkinator": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.0",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "web-vitals": "^5.3.0",
    "schema-dts": "^2.0.0"
  }
}
